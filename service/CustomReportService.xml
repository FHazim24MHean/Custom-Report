<service>
  <id>CustomReportGenerator</id>
  <name>Custom Report Generator</name>
  <description>Hosts the electrical reporting UI, API proxy, and report metadata service.</description>
  <executable>%BASE%\runtime\node.exe</executable>
  <arguments>"%BASE%\app\server.js"</arguments>
  <workingdirectory>%BASE%\app</workingdirectory>
  <env name="SERVICE_ENV_FILE" value="%BASE%\config\service.env" />
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <hidewindow>true</hidewindow>
  <stoptimeout>20 sec</stoptimeout>
  <serviceaccount>
    <username>NT AUTHORITY\LocalService</username>
  </serviceaccount>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="60 sec" />
  <resetfailure>1 hour</resetfailure>
  <logpath>%BASE%\logs</logpath>
  <log mode="roll" />
</service>
