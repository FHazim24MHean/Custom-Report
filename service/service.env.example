# Core service settings
PORT=__PORT__
API_ORIGIN=__API_ORIGIN__
APP_METADATA_PATH=__APP_METADATA_PATH__
REPORT_USERNAME=__REPORT_USERNAME__
REPORT_PASSWORD_HASH=__REPORT_PASSWORD_HASH__

# Only enable behind a trusted HTTPS reverse proxy that overwrites X-Forwarded-Proto.
# TRUST_PROXY_HTTPS=true

# Configure one upstream authentication method if GridVis requires it.
# API_AUTH_HEADER=Bearer token-here
# API_BEARER_TOKEN=token-here
# API_USERNAME=username
# API_PASSWORD=password
# API_COOKIE=session-cookie-here

# PostgreSQL is optional. Leave these commented to use the JSON metadata store.
# DATABASE_URL=postgresql://user:password@host:5432/database
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=custom_reports
# PGUSER=custom_report_service
# PGPASSWORD=password
# PGSSLMODE=require
